# =====================================================================
#  CONFIGURAÇÃO DO PROJETO APS
#  1. Copie este arquivo para .env
#  2. Preencha com suas credenciais reais
#  3. NUNCA suba o .env para o GitHub
# =====================================================================

# ── Banco de dados MySQL ──────────────────────────────────────────────
# O banco 'estacao_ambiental_db' é criado automaticamente se não existir
DB_URL=jdbc:mysql://localhost:3306/estacao_ambiental_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Sao_Paulo&characterEncoding=UTF-8
DB_USER=root
DB_PASSWORD=sua_senha_aqui

# ── API OpenWeatherMap ────────────────────────────────────────────────
# Crie uma conta gratuita em https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=sua_chave_aqui

# ── Porta do servidor (opcional, padrão: 8080) ───────────────────────
# PORT=8080
